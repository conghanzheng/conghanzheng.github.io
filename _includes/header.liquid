<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light auto-collapse-nav" role="navigation">
    <div class="container">
      
      <!-- Navbar Links (Left) -->
      <div class="collapse navbar-collapse show" id="navbarNav">
        <ul class="navbar-nav mr-auto flex-nowrap">
          <!-- Home Link -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              Home
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Research Link -->
          <li class="nav-item">
            <a class="nav-link" href="{{ '/#research' | relative_url }}">
              Research
            </a>
          </li>

          <!-- Teaching Link -->
          <li class="nav-item">
            <a class="nav-link" href="{{ '/#teaching' | relative_url }}">
              Teaching
            </a>
          </li>

          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="ti ti-search"></i></span>
              </button>
            </li>
          {% endif %}

          {% if site.enable_darkmode %}
            <!-- Toggle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="ti ti-sun-moon" id="light-toggle-system"></i>
                <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
                <i class="ti ti-sun-filled" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>

      <!-- Navbar Toggle (Appears only on tiny screens) -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <!-- Navbar Brand (Right) -->
      <div class="navbar-brand-container {% if page.permalink == '/' %}desktop-hide-brand{% endif %}">
        <a class="navbar-brand-link" href="{{ site.baseurl }}/">
          <div class="navbar-brand">
            {% if site.title == 'blank' %}
              {{- site.first_name }} {{ site.middle_name }} {{ site.last_name -}}
            {% else %}
              {{- site.title -}}
            {% endif %}
          </div>
          
          <!-- site.affiliation -->
          <div class="navbar-affiliation">{{ site.affiliation }}</div>
        </a>
      </div>
    </div>
  </nav>

  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>

<style>
  /* Base flex layout for links when space is available */
  .auto-collapse-nav .navbar-collapse {
    display: flex !important;
    flex-basis: auto;
  }
  
  .auto-collapse-nav .navbar-toggler {
    display: none; /* Hide toggle button by default */
  }

  /* Only collapse into a menu on extremely narrow viewports (e.g., small phones under 450px) */
  @media (max-width: 450px) {
    .auto-collapse-nav .navbar-collapse {
      display: none !important; /* Hide menu links */
    }

    .auto-collapse-nav .navbar-collapse.show {
      display: block !important; /* Show links when toggled */
    }

    .auto-collapse-nav .navbar-toggler {
      display: block; /* Show hamburger button */
    }
  }

  /* Navbar brand container styling */
  .navbar-brand-container {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    margin-right: 0;
    line-height: 1.5;
    z-index: 1040;
    position: relative;
  }
  
  .navbar-brand { 
    padding: 0;
    margin-bottom: 0;
    margin-right: 0;
    font-size: 1.25rem;
    display: block;
  }
  
  .navbar-affiliation {
    font-size: 1rem;
    display: block;
  }

  .navbar-brand-link {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    text-decoration: none;
    color: inherit;
  }

  .navbar-brand-link:hover {
    text-decoration: none;
    color: inherit;
  }

  .navbar-nav .nav-link.active {
    color: var(--global-theme-color);
  }

  .desktop-hide-brand {
    display: none;
  }
</style>